{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",

      "options": {
        "baseURL": "http://192.168.1.3:9931/v1"
      },

      "models": {
        "orcarouter-qwen3.8-27b": {
          "name": "Qwen3.8 27B",

          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          },

          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
